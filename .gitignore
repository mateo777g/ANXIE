# Las llaves del panel (Supabase y, más adelante, R2): nunca a git, el repo es público.
.env
.env.*
venv/
__pycache__/
config.json

# Lo que generan los generadores: los recibos llevan el correo y la contraseña de
# cuentas vendidas. Nunca a git (el repo es público).
biblioteca/

# Lo que genera "flet pack" al hacer el .exe: se rehace en cada build. El .exe, además,
# va con su .env al lado: ni el uno ni el otro pueden acabar en el repo.
build/
dist/
*.exe
*.spec
*.ico

# Documentación interna del diseño (con citas del dueño): se queda solo en la PC.
DISENO.md
